{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting": "Information",
      "System": "Warning"
    }
  },
  "AllowedHosts": "*",

  "OrderProcessing": {
    "MaxOrderItems": 50,
    "MinOrderAmount": 0.01,
    "MaxOrderAmount": 100000.00,
    "OrderExpirationMinutes": 30,
    "AutoCompletionDelay": {
      "MinSeconds": 1,
      "MaxSeconds": 5
    },
    "Currency": "USD"
  },

  "BackgroundJobs": {
    "OrderCompletionWorker": {
      "Enabled": true,
      "IntervalSeconds": 10
    },
    "OrderCleanupWorker": {
      "Enabled": true,
      "IntervalMinutes": 60,
      "RetentionDays": 30
    }
  },

  "Observability": {
    "ServiceName": "order-service",
    "ServiceVersion": "1.0.0",
    "Jaeger": {
      "Endpoint": "http://jaeger:4317",
      "Protocol": "grpc"
    },
    "Prometheus": {
      "MetricsPath": "/metrics",
      "Port": 5002
    },
    "Tracing": {
      "Enabled": true,
      "SamplingRatio": 1.0,
      "ExcludePaths": ["/health", "/metrics"],
      "CaptureRequestBody": false,
      "CaptureResponseBody": false
    },
    "Metrics": {
      "Enabled": true,
      "EnableRuntimeInstrumentation": true,
      "EnableAspNetCoreInstrumentation": true,
      "EnableHttpClientInstrumentation": true,
      "CustomMetrics": {
        "OrdersCreated": true,
        "OrdersCompleted": true,
        "OrdersCancelled": true,
        "TotalOrderAmount": true,
        "OrderProcessingTime": true,
        "AverageOrderValue": true
      }
    }
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithEnvironmentName"
    ],
    "Properties": {
      "Application": "OrderService",
      "Environment": "Production",
      "Domain": "Orders",
      "BusinessUnit": "E-Commerce"
    },
    "Filter": [
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "RequestPath like '/health%'"
        }
      }
    ]
  },

  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5002"
      }
    },
    "Limits": {
      "MaxConcurrentConnections": 200,
      "MaxRequestBodySize": 5242880,
      "RequestHeadersTimeout": "00:00:30",
      "KeepAliveTimeout": "00:02:00"
    }
  },

  "HealthChecks": {
    "Enabled": true,
    "Path": "/health",
    "Checks": {
      "Memory": true,
      "Threading": true
    }
  },

  "Cache": {
    "Enabled": false,
    "AbsoluteExpirationMinutes": 30,
    "SlidingExpirationMinutes": 10
  },

  "FeatureFlags": {
    "EnableOrderValidation": true,
    "EnableAutoCompletion": true,
    "EnableMetricsCollection": true,
    "EnableDetailedLogging": true
  }
}
