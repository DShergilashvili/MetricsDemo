{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "System": "Information"
    }
  },

  "Authentication": {
    "Jwt": {
      "SecretKey": "development-secret-key-min-32-chars-for-testing-only",
      "TokenExpirationMinutes": 1440
    },
    "PasswordPolicy": {
      "MinLength": 4,
      "RequireDigit": false,
      "RequireLowercase": false,
      "RequireUppercase": false,
      "RequireNonAlphanumeric": false
    }
  },

  "Observability": {
    "Jaeger": {
      "Endpoint": "http://localhost:4317"
    },
    "Tracing": {
      "SamplingRatio": 1.0,
      "CaptureRequestBody": true,
      "CaptureResponseBody": true
    },
    "Metrics": {
      "EnableDetailedMetrics": true
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "System": "Information"
      }
    },
    "Properties": {
      "Environment": "Development"
    }
  },

  "RateLimiting": {
    "Login": {
      "MaxAttempts": 100,
      "WindowMinutes": 1
    },
    "Registration": {
      "MaxAttempts": 100,
      "WindowMinutes": 1
    }
  }
}
